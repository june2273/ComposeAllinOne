{
  /* 테스트도 타입 검사한다.
     이 파일이 없던 동안 `tsc -b`가 src만 봐서, 테스트가 이미 사라진 필드를
     계속 넘겨도(예: Question.keyContext) 아무도 잡지 못했다. vitest는
     타입을 확인하지 않고 트랜스파일만 한다. */
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    /* `node`는 scripts/eval 때문에 필요하다 — 거기서 파일을 직접 읽는다 */
    "types": ["vite/client", "vitest/globals", "node"],
    "composite": true
  },
  /* `scripts/eval`도 함께 본다. 평가 하니스는 `npm test`에서 빠져 있어(vitest가
     `.eval.ts`를 안 잡는다) 여기서 검사하지 않으면 **아무도 안 본다** —
     그러다 core의 타입이 바뀌면 정작 재야 할 때 안 돌아간다. */
  "include": ["test", "src", "scripts/eval"]
}
